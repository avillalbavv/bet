# Configuración pública del frontend. La anon key de Supabase es pública;
# la seguridad depende de RLS y de las funciones RPC incluidas en /supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Recomendado: exponer 0xPlaySlots mediante una Edge Function/proxy propio.
VITE_0XPLAYSLOTS_PROXY_URL=

# Compatibilidad para pruebas locales. No usar una clave privada en producción:
# cualquier variable VITE_* termina visible en el navegador.
VITE_0XPLAYSLOTS_API_URL=https://api.0xplayslots.com/v1
VITE_0XPLAYSLOTS_API_KEY=

